# ---------------------------------------------------------------------------
# FleetTrack environment configuration
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Security — REQUIRED in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Cookies and reverse proxies
# Set COOKIE_SECURE=true and TRUST_PROXY=1 when HTTPS terminates at a proxy
# (Render, Railway, Fly.io, nginx). FORCE_HTTPS redirects all HTTP traffic.
COOKIE_SECURE=false
FORCE_HTTPS=false
TRUST_PROXY=0

# SQLite database file (created automatically; seeded on first run)
DB_PATH=./data/fleettrack.db

# Live telemetry simulator
SIMULATION=true
SIMULATOR_INTERVAL_MS=5000

# Optional local TLS certificate paths.
# `npm run dev:https` creates and wires these automatically.
# HTTPS_KEY=./.cert/localhost-key.pem
# HTTPS_CERT=./.cert/localhost-cert.pem
